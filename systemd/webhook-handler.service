[Unit]
Description=Webhook Handler for Catty App
After=network.target

[Service]
User=password_123
WorkingDirectory=/home/password_123/webhook-handler
ExecStart=/home/password_123/webhook-handler/venv/bin/python /home/password_123/webhook-handler/webhook_listener.py
Restart=always

[Install]
WantedBy=multi-user.target
